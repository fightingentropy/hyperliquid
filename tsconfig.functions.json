{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "functions/**/*.ts",
    "workers/liq-sweeper/src/**/*.ts",
    "src/server/**/*.js",
    "src/lib/equityResearch.js",
    "src/lib/liquidationSymbols.js",
    "worker-configuration.d.ts"
  ]
}
