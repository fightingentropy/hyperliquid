{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["functions/**/*.ts", "src/server/**/*.js", "src/lib/equityResearch.js", "src/lib/liquidationSymbols.js", "worker-configuration.d.ts"]
}
